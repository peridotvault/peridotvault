# Beehiiv (waitlist API, /api/subscribe). Names keep the existing double-I spelling.
NEXT_BEEHIIV_PUBLICATION_ID=
NEXT_BEEHIIV_API_KEY=

# Public Peridot URLs (all optional — fall back to defaults in features/peridot/peridot-urls.ts).
NEXT_PUBLIC_PERIDOT_APP_URL=
NEXT_PUBLIC_PERIDOT_DASHBOARD_URL=
NEXT_PUBLIC_PERIDOT_DOCS_URL=

# React Bits Pro registry (Pro tier). Never commit the real key — keep it in .env.local.
REACTBITS_LICENSE_KEY=
